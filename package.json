{
  "name": "mini-impl",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter koa-server run dev",
    "dev:client": "pnpm --filter react-fe run dev",
    "dev": "pnpm run dev:server & pnpm run dev:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tc": "pnpm --filter react-fe exec tsc -p tsconfig.app.json --noEmit && pnpm --filter koa-server exec tsc -p tsconfig.json --noEmit && pnpm --filter @ks/promise exec tsc -p tsconfig.json --noEmit && pnpm --filter @ks/reactive exec tsc -p tsconfig.json --noEmit",
    "format": "pnpm exec eslint apps packages --fix",
    "format:check": "pnpm exec eslint apps packages"
  },
  "keywords": [
    "micro-app",
    "monorepo"
  ],
  "author": "ks",
  "license": "ISC",
  "volta": {
    "node": "24.1.0",
    "pnpm": "10.11.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
