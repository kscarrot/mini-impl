{
  "name": "mini-impl",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter koa-server run dev",
    "dev:client": "pnpm --filter react-fe run dev",
    "dev": "pnpm run dev:server & pnpm run dev:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "pnpm --filter react-fe exec eslint . --fix",
    "format:check": "pnpm --filter react-fe exec eslint .",
    "cert:generate": "mykert -key-file apps/server/certificates/localhost-key.pem -cert-file apps/server/certificates/localhost.pem localhost 127.0.0.1 ::1"
  },
  "keywords": [
    "micro-app",
    "monorepo"
  ],
  "author": "ks",
  "license": "ISC",
  "volta": {
    "node": "24.1.0",
    "pnpm": "10.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
