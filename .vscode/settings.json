{
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "TypeScriptTeam.native-preview"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  //   "files.exclude": {
  //     "**/dist": true,
  //     "**/node_modules": true
  //   },
  "search.exclude": {
    "**/dist": true,
    "**/node_modules": true
  },
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/node_modules/**": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  }
}
